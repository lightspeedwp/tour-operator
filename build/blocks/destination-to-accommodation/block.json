{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "textdomain": "tour-operator",
  "name": "lsx-tour-operator/destination-to-accommodation",
  "title": "Destination to Accommodation",
  "category": "lsx-tour-operator",
  "editorScript": "file:index.js",
  "description": "Display accommodation available in the destination.",
  "icon": "admin-site",
  "keywords": [
    "destination",
    "accommodation",
    "connection"
  ],
  "example": {
    "attributes": {
      "metadata": {
        "name": "Destination to Accommodation"
      }
    },
    "innerBlocks": [
      [
        "core/group",
        {},
        [
          [
            "core/heading",
            {
              "content": "Accommodation in this Destination",
              "level": 3
            }
          ],
          [
            "core/query",
            {
              "query": {
                "postType": "accommodation",
                "perPage": 3
              }
            }
          ]
        ]
      ]
    ]
  }
}