              [
                "core/group",
                {
                  "style": {
                    "border": {
                      "width": "1px",
                      "style": "solid",
                      "color": "#e0e0e0"
                    },
                    "spacing": {
                      "padding": "1rem"
                    }
                  }
                },
                [
                  [
                    "core/heading",
                    {
                      "content": "Outstanding Experience",
                      "level": 4
                    }
