# Generic ignore used by some tools (ripgrep, editors)

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# IDEs
.idea/
.vscode/
*.sublime-workspace

# Build
build/
dist/
*.map

# Temp, logs
*.log
tmp/
.cache/

# Local env
.env
.env.*

# Tests and coverage
tests/
coverage/

# Archives
*.zip
*.tar.gz
*.sql

# Security - never include private keys or certs
*.ppk
*.pem
*.key
*.cer
*.crt
*.p12
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Backup files
*.bak
*.orig
*.old
*~
*.backup

# End
