{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"textdomain": "tour-operator",
	"name": "lsx-tour-operator/banner-cover",
	"version": "1.0.0",
	"title": "Banner Cover",
	"category": "lsx-tour-operator",
	"icon": "cover-image",
	"description": "Cover block using banner image from custom field",
	"editorScript": "file:./index.js",
  "supports": {
    "align": ["full", "wide"],
    "html": false
  },
	"attributes": {
		"metadata": {
			"type": "object",
			"default": {
				"name": "Banner Cover",
				"bindings": {
					"content": {
						"source": "lsx/post-meta",
						"args": {
							"key": "banner_image"
						}
					}
				}
			}
		},
		"dimRatio": {
			"type": "number",
			"default": 50
		},
		"minHeight": {
			"type": "number",
			"default": 400
		},
		"align": {
			"type": "string",
			"default": "full"
		},
		"className": {
			"type": "string",
			"default": "lsx-banner-cover"
		},
		"useFeaturedImage": {
			"type": "boolean",
			"default": true
		}
	},
	"keywords": [
		"banner",
		"cover",
		"hero"
	],
	"example": {
		"attributes": {
			"metadata": {
				"name": "Banner Cover"
			}
		},
		"innerBlocks": [
			[
				"core/cover",
				{
					"url": "",
					"alt": "Destination banner"
				},
				[
					[
						"core/heading",
						{
							"content": "Discover Africa",
							"level": 1,
							"textAlign": "center"
						}
					]
				]
			]
		]
	}
}
